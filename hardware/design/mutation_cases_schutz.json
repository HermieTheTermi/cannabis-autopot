    ]
   ],
   "expect": [
    "VBAT-Spannungsfestigkeit"
   ]
  },
  {
   "name": "R_ISET 100k -> 30k  [Regression]",
   "edits": [
    [
     "hardware/schaltplan_v1.md",
     "| **R_ISET** | **100 kΩ 1 %**",
     "| **R_ISET** | **30 kΩ 1 %**"
    ]
   ],
   "expect": [
    "Ladestrom IP2326"
   ]
  },
  {
   "name": "R_FB5_TOP 75k -> 100k  [Regression]",
   "edits": [
    [
     "hardware/schaltplan_v1.md",
     "| **R_FB5_TOP** | **75 kΩ**",
