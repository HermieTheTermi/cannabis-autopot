{
 "workdir": "hardware",
 "command": [
  "python3",
  "design/report.py"
 ],
 "summary_regex": "^\\s+- ([^:]+):",
 "cases": [
  {
   "name": "Ueberladung 4,28 V -> 4,60 V (9,2 V Pack)",
   "edits": [
    [
     "hardware/schaltplan_v1.md",
     "Überladung **4,28 V**",
     "Überladung **4,60 V**"
    ]
   ],
   "expect": [
    "Schutz-Schwellen"
   ]
  },
  {
   "name": "Tiefentladung 2,90 -> 3,40 V",
   "edits": [
    [
     "hardware/schaltplan_v1.md",
     "Tiefentladen **2,90 V",
     "Tiefentladen **3,40 V"
    ]
   ],
   "expect": [
    "Schutz-Schwellen"
   ]
  },
  {
   "name": "Ueberstromschwelle 200 mV -> 50 mV",
   "edits": [
    [
     "hardware/schaltplan_v1.md",
     "Überstrom **200 mV**",
     "Überstrom **50 mV**"
    ]
   ],
   "expect": [
    "Schutz-Ueberstrom"
   ]
  },
  {
   "name": "Q_PROT1 Source von BAT_MINUS auf GND",
