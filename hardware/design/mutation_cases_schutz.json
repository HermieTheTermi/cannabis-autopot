    ]
   ],
   "expect": [
    "Schutz-Serienkette"
   ]
  },
  {
   "name": "R_PROT_CS gegen BAT_MINUS statt GND",
   "edits": [
    [
     "hardware/schaltplan_v1_netzliste.csv",
     "PROT_CS,R_PROT_CS,1,",
     "BAT_MINUS,R_PROT_CS,1,"
    ]
   ],
   "expect": [
    "Schutz-Serienkette"
   ]
  },
  {
   "name": "U6 (5,5 V ESD) auf VBAT  [Regression]",
   "edits": [
    [
     "hardware/schaltplan_v1_netzliste.csv",
