# macOS
.DS_Store

# Build-Artefakte CAD
# STEP wird versioniert (echte CAD-Austauschdateien, klein),
# Meshes (STL/3MF) sind aus cad/export_all.py reproduzierbar.
case/build/
case/export/
cad/export/*.stl
cad/export/*.3mf
tools/**/node_modules/
node_modules/
*.stl
*.3mf
*.gcode

# KiCad
*.kicad_prl
*-backups/
fp-info-cache
*.bak
*.kicad_pcb-bak

# Python / Tooling
__pycache__/
.venv/
*.pyc
.env

# Logs
*.log

# EasyEDA-Tool-Cache (Export-Artefakte, lokal generiert)
.easyeda/

# EasyEDA-Playbook-Laufzeitlogs (nicht versionieren)
hardware/easyeda/rebuild/*.journal.jsonl
